{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://big-gains.local/ekf/schema/exercise-identity-v1",
  "title": "Big Gains EKF identity and compatibility source",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "release", "canonicalDefaults", "exercises"],
  "properties": {
    "$schema": { "const": "../schema/exercise-identity.schema.json" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "sourceBaseline", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 },
        "sourceBaseline": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "canonicalDefaults": {
      "type": "object",
      "description": "Materialized into every record before canonical validation. EKF-2 overlays the separately validated measurement contract source without changing identity."
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exercise" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "legacyId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentRevision", "canonicalName", "slug", "legacyIds", "aliases", "familyId", "variantOf", "compatibility"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "contentRevision": { "const": 1 },
        "canonicalName": { "type": "string", "minLength": 1 },
        "slug": { "$ref": "#/$defs/legacyId" },
        "legacyIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/legacyId" }
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "familyId": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "variantOf": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["legacyId", "day", "muscle", "equipment"],
          "properties": {
            "legacyId": { "$ref": "#/$defs/legacyId" },
            "day": { "type": "string", "minLength": 1 },
            "muscle": { "type": "string", "minLength": 1 },
            "equipment": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
