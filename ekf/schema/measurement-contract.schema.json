{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://big-gains.local/ekf/schema/measurement-contract-v1",
  "title": "Big Gains EKF-2 exercise measurement contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "releaseId", "description", "contracts"],
  "properties": {
    "$schema": { "const": "../schema/measurement-contract.schema.json" },
    "schemaVersion": { "const": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/contract" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "loadSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loadBasis", "resistanceSemantics"],
      "properties": {
        "loadBasis": { "enum": ["total", "per_hand", "per_side", "not_applicable", "unknown"] },
        "resistanceSemantics": { "enum": ["external", "bodyweight_only", "bodyweight_plus_external", "assistance", "machine_indicated", "not_applicable", "unknown"] }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadLabel": { "type": "string", "minLength": 1 },
        "loadUnit": { "type": "string", "minLength": 1 },
        "loadStep": { "type": "number", "exclusiveMinimum": 0 },
        "loadMayBeZero": { "type": "boolean" },
        "repsLabel": { "type": "string", "minLength": 1 },
        "distanceLabel": { "type": "string", "minLength": 1 },
        "distanceUnit": { "type": "string", "minLength": 1 },
        "distanceStep": { "type": "number", "exclusiveMinimum": 0 },
        "durationLabel": { "type": "string", "minLength": 1 },
        "durationUnit": { "type": "string", "minLength": 1 },
        "durationStep": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackingModel", "loadSemantics", "repSemantics", "bodyweightModel", "ui"],
      "properties": {
        "trackingModel": { "enum": ["load_reps", "reps_only", "assistance_reps", "duration", "distance_duration", "load_duration", "load_distance", "distance_only", "unknown"] },
        "loadSemantics": { "$ref": "#/$defs/loadSemantics" },
        "repSemantics": { "enum": ["bilateral_cycle", "reps_per_side", "total_events", "alternating_total", "not_applicable", "unknown"] },
        "bodyweightModel": { "anyOf": [{ "enum": ["full_system", "unsupported_fraction"] }, { "type": "null" }] },
        "loadUnitsPerEvent": { "type": "number", "exclusiveMinimum": 0 },
        "ui": { "$ref": "#/$defs/ui" }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["e1rmPermitted", "e1rmLoadBasis"],
      "properties": {
        "e1rmPermitted": { "type": "boolean" },
        "e1rmLoadBasis": { "anyOf": [{ "enum": ["entered_load", "combined_external_load", "effective_system_load"] }, { "type": "null" }] }
      }
    },
    "muscleRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "stabilizer"],
      "properties": {
        "primary": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "secondary": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "stabilizer": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exerciseId", "legacyId", "contentRevision", "laterality", "measurement", "analytics", "muscles"],
      "properties": {
        "exerciseId": { "$ref": "#/$defs/uuid" },
        "legacyId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "contentRevision": { "const": 2 },
        "laterality": { "enum": ["bilateral", "independent_bilateral", "unilateral", "alternating", "asymmetric", "not_applicable", "unknown"] },
        "measurement": { "$ref": "#/$defs/measurement" },
        "analytics": { "$ref": "#/$defs/analytics" },
        "muscles": { "$ref": "#/$defs/muscleRoles" }
      }
    }
  }
}
