{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://big-gains.local/ekf/schema/exercise-extension-v1",
  "title": "Big Gains EKF curated exercise release extension",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "releaseId", "schemaVersion", "exercises"],
  "properties": {
    "$schema": { "const": "../schema/exercise-extension.schema.json" },
    "releaseId": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./exercise-identity.schema.json#/$defs/exercise" }
    }
  }
}
