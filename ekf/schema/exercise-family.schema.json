{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://big-gains.local/ekf/schema/exercise-family-v1",
  "title": "Big Gains EKF-1 exercise families",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "families"],
  "properties": {
    "$schema": { "const": "../schema/exercise-family.schema.json" },
    "schemaVersion": { "const": 1 },
    "families": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "legacyId"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "name": { "type": "string", "minLength": 1 },
          "legacyId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
