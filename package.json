{
  "name": "big-gains-browser-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:ekf3-curation": "node scripts/generate-ekf3-curation.mjs",
    "check:ekf3-curation": "node scripts/generate-ekf3-curation.mjs --check",
    "generate:exercise-catalog": "npm run generate:ekf3-curation && node scripts/generate-exercise-catalog.mjs",
    "check:exercise-catalog": "npm run check:ekf3-curation && node scripts/generate-exercise-catalog.mjs --check",
    "test:ekf": "node --test tests/ekf-generator.test.mjs tests/ekf-measurement.test.mjs tests/ekf3-curation.test.mjs",
    "test": "npm run check:exercise-catalog && npm run test:program-domain && npm run test:program-domain-transport && npm run test:program-domain-recovery && npm run test:program-domain-cutover && playwright test",
    "test:program-domain": "node --test tests/program-domain-envelope.test.mjs",
    "test:program-domain-transport": "node --test tests/program-domain-sync.test.mjs",
    "test:program-domain-recovery": "node --test tests/program-domain-recovery.test.mjs",
    "test:program-domain-cutover": "node --test tests/program-domain-cutover.test.mjs",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:browser:report": "playwright show-report",
    "vendor:supabase": "node scripts/vendor-supabase-client.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "supabase": "2.112.0"
  }
}
